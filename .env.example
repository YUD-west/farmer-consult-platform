# PostgreSQL connection — use any host (see README: Supabase, Neon, or Windows install)
# Cloud URLs usually need SSL (enabled automatically for non-localhost hosts).
DATABASE_URL=postgres://postgres:dev@localhost:5432/yegnafarm

# Optional: force SSL on (true) or off (false). Default: SSL for remote hosts only.
# DATABASE_SSL=true

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d

# AI providers (optional - if none set, chatbot uses local fallback guidance)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROK_API_KEY=
GROK_MODEL=grok-2-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PREFERRED_AI_PROVIDERS=openai,claude,gemini,grok,deepseek

# CORS: your deployed web origin, e.g. https://yegnafarm.vercel.app
# Leave unset for local dev (reflects request origin).
FRONTEND_ORIGIN=

# API rate limit (per IP per 15 min window)
RATE_LIMIT_MAX=300

NODE_ENV=development

# Optional: npm run preflight only checks required files + DB if DATABASE_URL is set.
# For CI, require secrets: set STRICT_PREFLIGHT=1 (Unix: STRICT_PREFLIGHT=1 npm run preflight).
