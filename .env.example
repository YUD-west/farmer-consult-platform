# PostgreSQL connection — use any host (see README: Supabase, Neon, or Windows install)
# Cloud URLs usually need SSL (enabled automatically for non-localhost hosts).
DATABASE_URL=postgres://postgres:dev@localhost:5432/yegnafarm

# Optional: force SSL on (true) or off (false). Default: SSL for remote hosts only.
# DATABASE_SSL=true

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d

# OpenAI (optional — hybrid AI falls back to static message if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS: your deployed web origin, e.g. https://yegnafarm.vercel.app
# Leave unset for local dev (reflects request origin).
FRONTEND_ORIGIN=

# API rate limit (per IP per 15 min window)
RATE_LIMIT_MAX=300

NODE_ENV=development
